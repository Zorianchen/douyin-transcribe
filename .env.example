# ========================================
# 语音识别服务配置
# ========================================
# ASR_PROVIDER: 选择语音识别服务
#   siliconflow（默认，推荐）：硅基流动 SenseVoiceSmall，国内直连，完全免费
#   tencent：腾讯云录音文件识别极速版，国内直连，每月5小时免费
#   groq：Groq Whisper，需海外网络或代理
ASR_PROVIDER=siliconflow

# ---- 硅基流动配置（ASR_PROVIDER=siliconflow 时需要，推荐）----
# 在 https://siliconflow.cn 免费注册，获取 API Key
# SenseVoiceSmall 模型完全免费，不限时长
SILICONFLOW_API_KEY=sk-your-key-here
# 可选：模型，默认 FunAudioLLM/SenseVoiceSmall
# SILICONFLOW_MODEL=FunAudioLLM/SenseVoiceSmall

# ---- 腾讯云 ASR 配置（ASR_PROVIDER=tencent 时需要）----
# 在 https://console.cloud.tencent.com/cam/capi 获取
# 每月免费5小时录音文件识别极速版
# TENCENT_APP_ID=your_app_id
# TENCENT_SECRET_ID=your_secret_id
# TENCENT_SECRET_KEY=your_secret_key
# TENCENT_ASR_ENGINE=16k_zh_en

# 说明：硅基流动（SiliconFlow）的 API Key 已改为在「设置 → AI 模型（硅基流动）」中
# 按用户填写并保存（同时驱动语音识别与 AI 加工），不再依赖下面的环境变量。
# 下方 SILICONFLOW_API_KEY 仅作为未配置时的兜底，可留空。
# SILICONFLOW_API_KEY=sk-your-key-here

# ---- 服务端口 ----
PORT=3000

# ---- 可选：抖音 Cookie（云服务器部署强烈建议配置）----
# 抖音会拦截数据中心 IP（腾讯云/阿里云等），表现为"无法解析视频信息"。
# 解决方法：浏览器登录 www.douyin.com，F12 → Network → 任意请求 → 复制 Cookie 请求头整串粘贴到下面
# DOUYIN_COOKIE=ttwid=xxx; sessionid=xxx; ...

# ---- 可选：第三方抖音解析 API（2026-08 抖音反爬升级后的主通道）----
# 默认使用公共解析服务，无需修改。自建了解析服务可替换地址；设为 off 可关闭此通道
# DOUYIN_PARSE_API=https://api.bugpk.com/api/douyin?url=

# ---- 可选：自定义 ffmpeg / ffprobe 路径 ----
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# ---- 可选：系统代理 ----
# HTTPS_PROXY=http://127.0.0.1:7890
